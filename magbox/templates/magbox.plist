<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MagBox launchd service (macOS).
  Install:
    1. Edit the node path + script path below to match your machine.
    2. Copy to ~/Library/LaunchAgents/ai.magbox.plist
    3. launchctl load ~/Library/LaunchAgents/ai.magbox.plist
    4. Verify: curl http://localhost:9900/
  Optional env overrides (MAGBOX_PORT, MAGBOX_TO_AGENT, MAGBOX_FROM_AGENT, MAGBOX_BIND)
  go in an <key>EnvironmentVariables</key> dict if you want non-default dirs.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.magbox</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/ABSOLUTE/PATH/TO/magbox-server.js</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/magbox.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/magbox.log</string>
</dict>
</plist>
